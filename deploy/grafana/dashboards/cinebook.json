{
 "uid": "cinebook",
 "title": "CineBook - tải & sức khỏe",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Request/giây (theo status)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status)(rate(http_server_requests_seconds_count{job=\"app\"}[30s]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Độ trễ p50 / p95 / p99",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le)(rate(http_server_requests_seconds_bucket{job=\"app\"}[30s])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le)(rate(http_server_requests_seconds_bucket{job=\"app\"}[30s])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le)(rate(http_server_requests_seconds_bucket{job=\"app\"}[30s])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Lỗi 5xx / giây",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count{job=\"app\",status=~\"5..\"}[30s]))",
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Hikari: kết nối DB",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "hikaricp_connections_active{job=\"app\"}",
     "legendFormat": "active"
    },
    {
     "refId": "B",
     "expr": "hikaricp_connections_pending{job=\"app\"}",
     "legendFormat": "pending (đang chờ)"
    },
    {
     "refId": "C",
     "expr": "hikaricp_connections_max{job=\"app\"}",
     "legendFormat": "max"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Postgres: số kết nối theo trạng thái",
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (state)(pg_stat_activity_count{datname=\"cinebook\"})",
     "legendFormat": "{{state}}"
    },
    {
     "refId": "B",
     "expr": "pg_settings_max_connections",
     "legendFormat": "max_connections"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Postgres: commit / rollback mỗi giây",
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(pg_stat_database_xact_commit{datname=\"cinebook\"}[30s])",
     "legendFormat": "commit"
    },
    {
     "refId": "B",
     "expr": "rate(pg_stat_database_xact_rollback{datname=\"cinebook\"}[30s])",
     "legendFormat": "rollback"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "JVM heap",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(jvm_memory_used_bytes{job=\"app\",area=\"heap\"})",
     "legendFormat": "đang dùng"
    },
    {
     "refId": "B",
     "expr": "sum(jvm_memory_max_bytes{job=\"app\",area=\"heap\"})",
     "legendFormat": "tối đa"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "GC pause (giây / giây)",
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(jvm_gc_pause_seconds_sum{job=\"app\"}[30s])",
     "legendFormat": "{{action}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "CPU: app vs toàn máy",
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "process_cpu_usage{job=\"app\"}",
     "legendFormat": "app"
    },
    {
     "refId": "B",
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[30s]))",
     "legendFormat": "toàn máy"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "RAM máy chủ đã dùng",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes",
     "legendFormat": "RAM"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "CPU theo container",
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name)(rate(container_cpu_usage_seconds_total{name!=\"\"}[30s]))",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "RAM theo container",
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "container_memory_working_set_bytes{name!=\"\"}",
     "legendFormat": "{{name}}"
    }
   ]
  }
 ]
}